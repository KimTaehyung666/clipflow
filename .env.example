# Copy file ini jadi ".env" lalu isi key kamu (jangan commit .env ke GitHub!)
GROQ_API_KEY=isi_key_groq_kamu_disini
# Opsional: ganti model Groq (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# PENTING buat deploy cloud (Vercel/Render): YouTube memblokir ambil transcript
# dari IP server. Isi SALAH SATU key di bawah biar transcript diambil lewat API
# pihak ketiga (dua-duanya gratis, tanpa kartu):
# TRANSCRIPT_API_KEY=isi_key_dari_transcriptapi.com      (100 kredit awal)
# SUPADATA_API_KEY=isi_key_dari_supadata.ai             (100 kredit/bulan)
# Tanpa key di atas, user tetap bisa tempel transcript manual di web-nya.
